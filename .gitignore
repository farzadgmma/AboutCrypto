# .gitignore
# این فایل مشخص می‌کند که کدام فایل‌ها و پوشه‌ها نباید توسط گیت (سیستم ورژن کنترل) دنبال شوند.

# فایل تنظیمات اصلی که حاوی اطلاعات حساس است
config/config.php

# فایل‌های مربوط به محیط توسعه و سیستم عامل
.DS_Store
.idea/
.vscode/

# پوشه vendor که توسط Composer مدیریت می‌شود (اگر در آینده اضافه شود)
vendor/
composer.lock
